        "supplier": {
          "type": "string"
        },
        "sku": {
          "type": "string"
        },
        "quantity": {
          "type": "integer",
          "minimum": 1
        },
        "needed_by": {
          "type": "string",
          "format": "date"
        },
        "ticket_id": {
          "type": "string"
        }
      },
      "required": [
        "supplier",
        "sku",
        "quantity"
      ]
    },
    "sampleInput": {
      "supplier": "Coastal Restaurant Supply",
      "sku": "CAN-OIL-35",
      "quantity": 6,
      "ticket_id": "TKT-005"
    },
    "sampleOutput": {
      "status": "interrupted",
      "approval_id": "APR-104",
      "waiting_for": "kitchen_manager"
