# LineMate front-end settings (Vite reads front-end/.env, .env.local, .env.production, ...).

# Where `npm run dev` and `npm run preview` forward /api requests (the FastAPI back-end).
VITE_API_PROXY_TARGET=http://localhost:8000

# Leave empty when the UI and API share one origin (dev proxy or a reverse proxy in production).
# Set it to the API origin when the built UI is hosted elsewhere, e.g. https://api.example.com
VITE_API_BASE_URL=

# Dev and preview server ports
VITE_PORT=5173
VITE_PREVIEW_PORT=4173
