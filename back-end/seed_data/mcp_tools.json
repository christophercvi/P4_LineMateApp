[
  {
    "name": "search_documents",
    "access": "read",
    "requiresApproval": false,
    "callsLast7d": 184,
    "roles": [
      "line_cook",
      "sous_chef",
      "kitchen_manager",
      "admin",
      "service"
    ],
    "description": "Semantic search over the kitchen knowledge base. Results are filtered by the caller's role (Incident Reports hidden from line cooks).",
    "inputSchema": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "description": "Natural-language question"
        },
        "category": {
          "type": "string",
          "enum": [
            "recipe",
            "sop",
            "incident",
            "onboarding"
          ]
        },
        "station": {
          "type": "string",
          "enum": [
            "grill",
            "pastry",
            "prep",
            "foh"
          ]
        },
        "k": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10,
          "default": 4
        }
      },
      "required": [
        "query"
      ]
    },
    "sampleInput": {
      "query": "how fast must a stockpot cool",
      "k": 2
    },
    "sampleOutput": [
      {
        "doc_id": "DOC-SOP-003",
        "title": "Cooling Hot Foods (Two-Stage Cooling)",
        "score": 0.82,
        "last_reviewed_days": 240,
        "stale": true
      },
      {
        "doc_id": "DOC-ONB-005",
        "title": "Food Safety Basics: Temperature Danger Zone",
        "score": 0.71,
        "last_reviewed_days": 35,
        "stale": false
      }
    ]
  },
  {
    "name": "list_open_tickets",
    "access": "read",
    "requiresApproval": false,
    "callsLast7d": 96,
