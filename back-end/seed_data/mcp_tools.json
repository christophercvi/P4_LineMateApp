  {
    "name": "create_ticket",
    "access": "write",
    "requiresApproval": true,
    "callsLast7d": 12,
    "roles": [
      "line_cook",
      "sous_chef",
      "kitchen_manager",
      "service"
    ],
    "description": "Opens a ticket. From the web app it is immediate; from an external MCP client it pauses for Kitchen Manager approval.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 140
        },
        "description": {
          "type": "string"
        },
        "priority": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "station": {
          "type": "string",
          "enum": [
            "grill",
            "pastry",
            "prep",
            "foh"
          ]
        },
        "related_doc_id": {
          "type": "string"
        }
      },
      "required": [
        "title",
        "priority",
        "station"
      ]
    },
    "sampleInput": {
      "title": "Ice machine leaking",
      "priority": "medium",
      "station": "prep"
    },
    "sampleOutput": {
      "id": "TKT-041",
      "status": "open"
    }
  },
  {
    "name": "draft_supply_order",
    "access": "write",
    "requiresApproval": true,
    "callsLast7d": 3,
    "roles": [
      "sous_chef",
      "kitchen_manager",
