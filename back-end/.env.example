# LineMate back-end settings (read by back_end.core.config.Settings from back-end/.env).
# Every value has a safe default; copy this file to .env and change what you need.

# --- Application ---------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=info
# Emit JSON log lines (structlog) instead of the coloured console renderer
LOG_JSON=false

# --- Server (Granian) ----------------------------------------------------------
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Host headers accepted by the streamable-HTTP MCP endpoint mounted at /mcp
MCP_ALLOWED_HOSTS=["localhost:*","127.0.0.1:*","localhost","127.0.0.1"]

# --- Database ------------------------------------------------------------------
# SQLite3 in memory (aiosqlite). Every table is created and seeded on each start.
DATABASE_URL=sqlite+aiosqlite:///:memory:
SEED_ON_STARTUP=true
VECTORIZE_ON_STARTUP=true
# Password given to every seeded account
SEED_PASSWORD=Hearthline#2026

# --- Auth ----------------------------------------------------------------------
# Passwords and service tokens are hashed with Argon2; access tokens are HS256 JWTs signed with this secret.
JWT_SECRET=change-me-to-a-long-random-string-for-linemate
ACCESS_TOKEN_MINUTES=480
# Lifetime of signed file download links
FILE_URL_TTL_SECONDS=3600

# --- Files and vectors ---------------------------------------------------------
# Uploaded documents and ticket attachments (documents/, attachments/, chat/ and a parse cache)
STORAGE_DIR=storage
# Persistent Chroma collections (documents and photos)
CHROMA_DIR=chroma_db
MAX_UPLOAD_MB=20

# --- Local models (Ollama) -----------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=nomic-embed-text
# Used when a request does not name a model
CHAT_MODEL=llama3.2:3b
# Shown first in pickers; any other model pulled into Ollama is discovered automatically
SUPPORTED_MODELS=["llama3.2:3b","qwen3:4b-q4_K_M","gemma4:e2b"]
OLLAMA_KEEP_ALIVE=15m
OLLAMA_TIMEOUT_SECONDS=600
NUM_CTX=8192
MAX_ANSWER_TOKENS=900

# --- Photo embeddings ----------------------------------------------------------
# nomic-embed-vision-v1.5 runs inside the API process (Transformers, CPU)
VISION_ENABLED=true
VISION_MODEL=nomic-ai/nomic-embed-vision-v1.5

# --- Retrieval -----------------------------------------------------------------
STALE_DAYS=180
CHUNK_TOKENS=380
CHUNK_OVERLAP=60
RETRIEVAL_K=4
# similarity | mmr | threshold
RETRIEVAL_STRATEGY=mmr
SCORE_THRESHOLD=0.42
MIN_RELEVANCE=0.35
MEMORY_WINDOW=6

# --- External MCP servers (shift scheduler, supplier inventory) ----------------
MCP_EXTERNAL_ENABLED=true
MCP_CALL_TIMEOUT_SECONDS=20
