      "sous_chef",
      "kitchen_manager",
      "admin",
      "service"
    ],
    "description": "Open tickets with priority, station, assignee and linked document. Sous chefs only see their own station.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "station": {
          "type": "string",
          "enum": [
            "grill",
            "pastry",
            "prep",
            "foh"
          ]
        },
        "min_priority": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "limit": {
          "type": "integer",
          "default": 20
        }
      }
    },
    "sampleInput": {
      "min_priority": "critical"
    },
    "sampleOutput": [
      {
        "id": "TKT-001",
        "title": "Hood suppression inspection overdue after flare-up on grill #1",
        "station": "grill",
        "assignee": "CM-02"
      },
      {
        "id": "TKT-017",
        "title": "Blast chiller not pulling down — chili hit 88°F at the 2 h check",
        "station": "prep",
        "assignee": "CM-10"
      }
    ]
  },
  {
